# 热重载开关的唯一入口：Gradle 任务、run.sh、reload 都读这里。
# 打开热重载时这些默认值就是对的，不需要再手工 export。
KALDO_SYNTH_EH_FRAME=1          # 由 compact unwind 合成 __eh_frame，异常穿过 JIT 代码时必须
KALDO_KEEP_COMPACT_UNWIND=1     # merge-payloads 保留 compact unwind，供上一条合成
KONAN_HOT_RELOAD_CACHE_ONLY=1   # 编译器构建完缓存即返回，跳过被丢弃的 host 链接
# KALDO_HOT_SYMBOLS=             # 不在这里设：run.sh 启动时传 build/app/hot-symbols.txt（收窄清单）。
#                                 # 留空 = 全部 Kotlin 符号外部化，冷启动约 20% SIGSEGV，见 INTERFACE §3.3
