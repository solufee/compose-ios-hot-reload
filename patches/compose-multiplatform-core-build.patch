+ * limitations under the License.
+ */
+
+@file:OptIn(
+    ExperimentalComposeRuntimeApi::class,
+    ExperimentalForeignApi::class,
+    ExperimentalNativeApi::class,
+    NativeRuntimeApi::class,
+)
+
+package androidx.compose.ui.scene
+
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.ControlledComposition
+import androidx.compose.runtime.ExperimentalComposeRuntimeApi
+import androidx.compose.runtime.RecomposeScope
+import androidx.compose.runtime.Recomposer
+import androidx.compose.runtime.currentComposer
+import androidx.compose.runtime.remember
+import androidx.compose.runtime.tooling.CompositionObserver
+import androidx.compose.runtime.tooling.CompositionObserverHandle
+import androidx.compose.runtime.tooling.CompositionRegistrationObserver
+import androidx.compose.runtime.tooling.ObservableComposition
+import kotlin.experimental.ExperimentalNativeApi
+import kotlin.native.Platform
+import kotlin.native.runtime.HotReload
+import kotlin.native.runtime.NativeRuntimeApi
+import kotlinx.cinterop.ExperimentalForeignApi
+import kotlinx.cinterop.toKString
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.flow.first
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.withTimeoutOrNull
+import kotlinx.coroutines.yield
+import platform.Foundation.NSDate
+import platform.Foundation.NSThread
+import platform.Foundation.timeIntervalSince1970
+import platform.posix.getenv
+
+/*
+ * Hot reload with the Kotlin/Native "hotreload" debug toolchain (these klibs are only used by
+ * that toolchain; release builds use the published Compose artifacts).
+ *
+ * After the runtime swaps code in, Compose recomposes only scopes whose inputs changed, so a
+ * call site whose arguments the compiler treats as static (string literals, constants,
+ * singleton lambdas) keeps showing the old UI. Two steps fix that without losing state:
+ *
+ * 1. Every scene composition calls Composer.collectParameterInformation() on its first
+ *    composition (HotReloadRecomposeRoot). The composer then keeps a recompose scope for every
+ *    restartable group, not only for groups that read state; compositions created below it
+ *    (Dialog/Popup layers, lazy list items, subcompositions) inherit this.
+ * 2. After each successful reload (HotReload success handler, called on the reload thread) the
+ *    main thread invalidates every scope of every composition of every running Recomposer
+ *    (ControlledComposition.invalidateAll). The next frame re-runs each restartable body with
+ *    the arguments its caller passes now. The slot tables are kept, so remember and
+ *    rememberSaveable state survive.
+ *
+ * The work runs on the main thread, which also runs the recomposers, so it never runs inside a
+ * composition or apply. If a composition is composing or has unapplied changes, the attempt is
+ * re-queued on the main thread and logged.
+ *
+ * Only in debug binaries (Platform.isDebugBinary; hot reload builds use -g). In an optimized
+ * binary built with these klibs the code is present but does nothing.
+ * KONAN_HR_FORCE_RECOMPOSE=0 in the app's environment turns both steps off.
+ *
+ * Log lines (stdout, prefix "HR forceRecompose"):
+ *   on | off (KONAN_HR_FORCE_RECOMPOSE=0)
+ *   deferred (composition busy), retrying on main
+ *   recomposers=R compositions=C invalidated=I recomposed=S deferred=D dispatchMs=..
+ *     forceMs=.. frameMs=.. totalMs=.. frameEpochMs=..
+ * invalidated: scopes invalidated; recomposed: scopes entered in the forced frame;
+ * dispatchMs: reload success -> main thread; forceMs: invalidation; frameMs: invalidation ->
+ * all recomposers idle again (recomposed and applied); totalMs: reload success -> idle.
+ */
+
+private const val MAX_DEFERRALS = 600
+private const val FRAME_TIMEOUT_MS = 10_000L
+
+private val forceRecomposeEnabled: Boolean by lazy {
+    if (!Platform.isDebugBinary) return@lazy false
+    val on = getenv("KONAN_HR_FORCE_RECOMPOSE")?.toKString() != "0"
+    println(if (on) "HR forceRecompose: on" else "HR forceRecompose: off (KONAN_HR_FORCE_RECOMPOSE=0)")
+    on
+}
+
+// Main thread only.
+private var handlerInstalled = false
+
+/** Wraps the content of every scene composition (root and layers); see the file comment. */
+@Composable
+internal fun HotReloadRecomposeRoot(content: @Composable () -> Unit) {
+    if (forceRecomposeEnabled) {
+        val composer = currentComposer
+        remember {
+            composer.collectParameterInformation()
+            installReloadHandler()
+            0
+        }
+    }
+    content()
+}
+
+private fun installReloadHandler() {
+    if (handlerInstalled) return
+    handlerInstalled = true
+    HotReload.addReloadSuccessHandler { onReloadSuccess() }
+}
+
+private fun nowMs(): Double = NSDate().timeIntervalSince1970 * 1000.0
+
+// Reload thread.
+private fun onReloadSuccess() {
+    val reloaded = nowMs()
+    try {
+        CoroutineScope(Dispatchers.Main).launch { forceRecomposeOnMain(reloaded) }
+    } catch (e: Throwable) {
+        println("HR forceRecompose: cannot reach the main thread: $e")
+    }
+}
+
+private class ScopeCounter : CompositionObserver {
+    var invalidated = 0
+    var entered = 0
+    override fun onBeginComposition(composition: ObservableComposition) {}
+    override fun onScopeEnter(scope: RecomposeScope) { entered++ }
+    override fun onReadInScope(scope: RecomposeScope, value: Any) {}
+    override fun onScopeExit(scope: RecomposeScope) {}
+    override fun onEndComposition(composition: ObservableComposition) {}
+    override fun onScopeInvalidated(scope: RecomposeScope, value: Any?) { invalidated++ }
+    override fun onScopeDisposed(scope: RecomposeScope) {}
+}
+
+private fun knownCompositions(): List<ControlledComposition> {
+    val result = mutableListOf<ControlledComposition>()
+    val collector =
+        object : CompositionRegistrationObserver {
+            override fun onCompositionRegistered(composition: ObservableComposition) {
+                if (composition is ControlledComposition && !composition.isDisposed) {
+                    result += composition
+                }
+            }
+            override fun onCompositionUnregistered(composition: ObservableComposition) {}
+        }
+    // observe() reports the compositions that are registered now, synchronously.
+    Recomposer.runningRecomposers.value.forEach { it.observe(collector)?.dispose() }
+    return result
+}
+
+/**
+ * Main thread, outside composition and apply. Invalidates every scope of every known
+ * composition; returns the compositions, or null when one is busy (nothing was changed).
+ */
+private fun forceRecomposeAllForHotReload(
+    counter: ScopeCounter,
+    handles: MutableList<CompositionObserverHandle>,
+): List<ControlledComposition>? {
+    check(NSThread.isMainThread) { "HR forceRecompose must run on the main thread" }
+    val compositions = knownCompositions()
+    if (compositions.any { it.isComposing || it.hasPendingChanges }) return null
+    compositions.forEach { composition ->
+        (composition as? ObservableComposition)?.setObserver(counter)?.let { handles += it }
+        composition.invalidateAll()
+    }
+    return compositions
+}
+
+private suspend fun forceRecomposeOnMain(reloaded: Double) {
+    val onMain = nowMs()
+    val counter = ScopeCounter()
+    val handles = mutableListOf<CompositionObserverHandle>()
+    var deferred = 0
+    var compositions: List<ControlledComposition>?
+    while (true) {
+        compositions = forceRecomposeAllForHotReload(counter, handles)
+        if (compositions != null) break
+        if (deferred == 0) println("HR forceRecompose: deferred (composition busy), retrying on main")
+        if (++deferred > MAX_DEFERRALS) {
+            println("HR forceRecompose: gave up after $deferred attempts")
+            return
+        }
+        yield()
+    }
+    val forced = nowMs()
+    val recomposers = Recomposer.runningRecomposers.value
+    val idle =
+        try {
+            withTimeoutOrNull(FRAME_TIMEOUT_MS) {
+                recomposers.forEach { info -> info.state.first { it <= Recomposer.State.Idle } }
+                true
+            } ?: false
+        } finally {
+            handles.forEach { it.dispose() }
+        }
+    val done = nowMs()
+    println(
+        "HR forceRecompose recomposers=${recomposers.size} compositions=${compositions!!.size} " +
+            "invalidated=${counter.invalidated} recomposed=${counter.entered} deferred=$deferred " +
+            "dispatchMs=${(onMain - reloaded).toLong()} forceMs=${(forced - onMain).toLong()} " +
+            "frameMs=${if (idle) (done - forced).toLong().toString() else "timeout"} " +
+            "totalMs=${(done - reloaded).toLong()} frameEpochMs=${done.toLong()}"
+    )
+}
