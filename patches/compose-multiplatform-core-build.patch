+
+/*
+ * Hot reload with the Kotlin/Native "hotreload" debug toolchain (these klibs are only used by
+ * that toolchain; release builds use the published Compose artifacts).
+ *
+ * After the runtime swaps code in, Compose recomposes only scopes whose inputs changed, so a
+ * call site whose arguments the compiler treats as static (string literals, constants,
+ * singleton lambdas) keeps showing the old UI. Two steps fix that without losing state:
+ *
+ * 1. Every scene composition calls Composer.collectParameterInformation() on its first
+ *    composition (HotReloadRecomposeRoot). The composer then keeps a recompose scope for every
+ *    restartable group, not only for groups that read state; compositions created below it
+ *    (Dialog/Popup layers, lazy list items, subcompositions) inherit this.
+ * 2. After each successful reload (HotReload success handler) the
+ *    main thread invalidates every scope of every composition of every running Recomposer
+ *    (ControlledComposition.invalidateAll). The next frame re-runs each restartable body with
+ *    the arguments its caller passes now. The slot tables are kept, so remember and
+ *    rememberSaveable state survive.
+ *
+ * The work runs on the main thread, which also runs the recomposers, so it never runs inside a
+ * composition or apply. The handler marks the reload as pending, then:
+ *  - The runtime of hot reload toolchains from .8 on runs the reload itself on the main queue,
+ *    between two frames, and calls the handler there: it invalidates at once (via=reload).
+ *  - Otherwise (handler on another thread, or a composition busy) the main thread invalidates at
+ *    whichever comes first: the start of the next recomposer frame of any window
+ *    (FrameChoreographer.performRecomposerFrameIfNeeded calls forceRecomposeBeforeFrameIfReloaded,
+ *    via=frame) or the main-queue task the handler posts (via=task).
+ * So no frame recomposes anything before the invalidation: otherwise a composable that recomposes
+ * alone in that frame would run a restart lambda migrated from the old code, whose captured
+ * parameters do not match the new function after a signature change (Issue #27).
+ * If a composition is composing or has unapplied changes, the attempt is retried and logged.
+ *
+ * Only in debug binaries (Platform.isDebugBinary; hot reload builds use -g). In an optimized
+ * binary built with these klibs the code is present but does nothing.
+ * KONAN_HR_FORCE_RECOMPOSE=0 in the app's environment turns both steps off.
+ * Test switches (acceptance only): KONAN_HR_TEST_TASK_DELAY_MS=<n> delays the posted task by n ms;
+ * KONAN_HR_TEST_NO_FRAME_ENTRY=1 skips the frame-entry check and the invalidation inside the handler
+ * (with KONAN_HR_RELOAD_ON_MAIN=0 for the runtime, the behaviour before Issue #27).
+ *
+ * Log lines (stdout, prefix "HR forceRecompose"):
+ *   on | off (KONAN_HR_FORCE_RECOMPOSE=0)
+ *   deferred (composition busy), retrying on main
+ *   recomposers=R compositions=C invalidated=I recomposed=S deferred=D via=reload|frame|task
+ *     dispatchMs=.. forceMs=.. frameMs=.. totalMs=.. frameEpochMs=..
+ * invalidated: scopes invalidated; recomposed: scopes entered in the forced frame; via: who
+ * invalidated (the handler on the main queue, the frame entry or the posted task); dispatchMs: reload success -> main thread;
+ * forceMs: invalidation; frameMs: invalidation ->
+ * all recomposers idle again (recomposed and applied); totalMs: reload success -> idle.
+ */
+
+private const val MAX_DEFERRALS = 600
+private const val FRAME_TIMEOUT_MS = 10_000L
+
+private val forceRecomposeEnabled: Boolean by lazy {
+    if (!Platform.isDebugBinary) return@lazy false
+    val on = getenv("KONAN_HR_FORCE_RECOMPOSE")?.toKString() != "0"
+    println(if (on) "HR forceRecompose: on" else "HR forceRecompose: off (KONAN_HR_FORCE_RECOMPOSE=0)")
+    on
+}
+
+private val testTaskDelayMs: Long by lazy {
+    getenv("KONAN_HR_TEST_TASK_DELAY_MS")?.toKString()?.toLongOrNull() ?: 0L
+}
+private val testNoFrameEntry: Boolean by lazy {
+    getenv("KONAN_HR_TEST_NO_FRAME_ENTRY")?.toKString() == "1"
+}
+
+// Main thread only.
+private var handlerInstalled = false
+
+/** Wraps the content of every scene composition (root and layers); see the file comment. */
+@Composable
+internal fun HotReloadRecomposeRoot(content: @Composable () -> Unit) {
+    if (forceRecomposeEnabled) {
+        val composer = currentComposer
+        remember {
+            composer.collectParameterInformation()
+            installReloadHandler()
+            0
+        }
+    }
+    content()
+}
+
+private fun installReloadHandler() {
+    if (handlerInstalled) return
+    handlerInstalled = true
+    HotReload.addReloadSuccessHandler { onReloadSuccess() }
+}
+
+private fun nowMs(): Double = NSDate().timeIntervalSince1970 * 1000.0
+
+// 1 from a successful reload until the main thread has invalidated (reload thread sets, main clears).
+private val reloadPending = AtomicInt(0)
+private val reloadedAtMs = AtomicLong(0)
+
+// Main queue (runtime from .8) or the reload thread.
+private fun onReloadSuccess() {
+    reloadedAtMs.value = nowMs().toLong()
+    reloadPending.value = 1
+    // Between two frames on the main thread: invalidate now, before any frame can run.
+    if (NSThread.isMainThread && !testNoFrameEntry && forceNow(via = "reload", deferred = 0)) return
+    try {
+        CoroutineScope(Dispatchers.Main).launch {
+            if (testTaskDelayMs > 0) delay(testTaskDelayMs)
+            forceRecomposeOnMain()
+        }
+    } catch (e: Throwable) {
+        println("HR forceRecompose: cannot reach the main thread: $e")
+    }
+}
+
+/**
+ * Main thread, right before a recomposer frame (FrameChoreographer), outside composition and
+ * apply. Does the pending forced invalidation of a reload first, so that frame already recomposes
+ * from the parents down. Costs one atomic read when nothing is pending.
+ */
+internal fun forceRecomposeBeforeFrameIfReloaded() {
+    if (reloadPending.value == 0 || testNoFrameEntry) return
+    forceNow(via = "frame", deferred = 0)
+}
+
+private class ScopeCounter : CompositionObserver {
+    var invalidated = 0
+    var entered = 0
+    override fun onBeginComposition(composition: ObservableComposition) {}
+    override fun onScopeEnter(scope: RecomposeScope) { entered++ }
+    override fun onReadInScope(scope: RecomposeScope, value: Any) {}
+    override fun onScopeExit(scope: RecomposeScope) {}
+    override fun onEndComposition(composition: ObservableComposition) {}
+    override fun onScopeInvalidated(scope: RecomposeScope, value: Any?) { invalidated++ }
+    override fun onScopeDisposed(scope: RecomposeScope) {}
+}
+
+private fun knownCompositions(): List<ControlledComposition> {
+    val result = mutableListOf<ControlledComposition>()
+    val collector =
+        object : CompositionRegistrationObserver {
+            override fun onCompositionRegistered(composition: ObservableComposition) {
+                if (composition is ControlledComposition && !composition.isDisposed) {
+                    result += composition
+                }
+            }
+            override fun onCompositionUnregistered(composition: ObservableComposition) {}
+        }
+    // observe() reports the compositions that are registered now, synchronously.
+    Recomposer.runningRecomposers.value.forEach { it.observe(collector)?.dispose() }
+    return result
+}
+
+/**
+ * Main thread, outside composition and apply. Invalidates every scope of every known
+ * composition; returns the compositions, or null when one is busy (nothing was changed).
+ */
+private fun forceRecomposeAllForHotReload(
+    counter: ScopeCounter,
+    handles: MutableList<CompositionObserverHandle>,
+): List<ControlledComposition>? {
+    check(NSThread.isMainThread) { "HR forceRecompose must run on the main thread" }
+    val compositions = knownCompositions()
+    if (compositions.any { it.isComposing || it.hasPendingChanges }) return null
+    compositions.forEach { composition ->
+        (composition as? ObservableComposition)?.setObserver(counter)?.let { handles += it }
+        composition.invalidateAll()
+    }
+    return compositions
+}
+
+// Main thread. Invalidates if nothing has done it yet; returns false if a composition was busy
+// (the reload stays pending, and the next frame or a retry does it).
+private fun forceNow(via: String, deferred: Int): Boolean {
+    if (!reloadPending.compareAndSet(1, 0)) return true
+    val onMain = nowMs()
+    val counter = ScopeCounter()
+    val handles = mutableListOf<CompositionObserverHandle>()
+    val compositions = forceRecomposeAllForHotReload(counter, handles)
+    if (compositions == null) {
+        reloadPending.value = 1
+        return false
+    }
+    val forced = nowMs()
+    CoroutineScope(Dispatchers.Main).launch {
+        reportForcedFrame(via, deferred, onMain, forced, compositions.size, counter, handles)
+    }
+    return true
+}
+
+private suspend fun forceRecomposeOnMain() {
+    var deferred = 0
+    while (reloadPending.value == 1) {
+        if (forceNow(via = "task", deferred = deferred)) return
+        if (deferred == 0) println("HR forceRecompose: deferred (composition busy), retrying on main")
+        if (++deferred > MAX_DEFERRALS) {
+            println("HR forceRecompose: gave up after $deferred attempts")
+            reloadPending.value = 0
+            return
+        }
+        yield()
+    }
+}
+
+private suspend fun reportForcedFrame(
+    via: String,
+    deferred: Int,
+    onMain: Double,
+    forced: Double,
+    compositions: Int,
+    counter: ScopeCounter,
+    handles: List<CompositionObserverHandle>,
+) {
+    val reloaded = reloadedAtMs.value.toDouble()
+    val recomposers = Recomposer.runningRecomposers.value
+    val idle =
+        try {
+            withTimeoutOrNull(FRAME_TIMEOUT_MS) {
+                recomposers.forEach { info -> info.state.first { it <= Recomposer.State.Idle } }
+                true
+            } ?: false
+        } finally {
+            handles.forEach { it.dispose() }
+        }
+    val done = nowMs()
+    println(
+        "HR forceRecompose recomposers=${recomposers.size} compositions=$compositions " +
+            "invalidated=${counter.invalidated} recomposed=${counter.entered} deferred=$deferred " +
+            "via=$via dispatchMs=${(onMain - reloaded).toLong()} forceMs=${(forced - onMain).toLong()} " +
+            "frameMs=${if (idle) (done - forced).toLong().toString() else "timeout"} " +
+            "totalMs=${(done - reloaded).toLong()} frameEpochMs=${done.toLong()}"
+    )
+}
+
+// ---- First-frame ready marker (Issue #60, INTERFACE §6.1) -----------------------------------------------------------
+// After the first frame that is actually committed to Metal in this process (any window, either redrawer), print once:
+//   HR READY first-frame epochMs=<host clock, ms>
+// so hot reload drivers know the app is up without waiting a fixed time. Only in hot reload binaries: debug and compiled
+// with the split scheme (HotReload.isEnabled); release, optimized and ordinary debug binaries never print it.
+// KONAN_HR_READY_MARKER=0 in the app's environment turns it off (to test the consumers' fallback).
+
+// No new top-level state on purpose: every top-level property or object adds a storage record to the global
+// initialization of every binary, release included. The once-only flag lives in the process environment instead.
+// Frames of one redrawer are committed one after another (main thread or its serial rendering queue), so in
+// practice the line is printed once; consumers take the first one anyway.
+private const val READY_MARKER_SEEN = "KONAN_HR_READY_MARKER_SEEN"
+
+/** Called by both Metal redrawers right after a frame's command buffer is committed (only in hot reload binaries). */
+internal fun hotReloadFrameCommitted() {
+    if (!Platform.isDebugBinary || getenv(READY_MARKER_SEEN) != null) return
+    setenv(READY_MARKER_SEEN, "1", 1)
+    if (getenv("KONAN_HR_READY_MARKER")?.toKString() == "0") return
+    println("HR READY first-frame epochMs=${epochMsPosix()}")
+}
+
+// Host clock via POSIX, not NSDate (a new use of an ObjC class here would reorder the binary's class references) and
+// without a struct (memScoped/alloc add global state): release code stays the same even though it never calls this.
+private fun epochMsPosix(): Long = (clock_gettime_nsec_np(CLOCK_REALTIME.convert()) / 1_000_000uL).toLong()
