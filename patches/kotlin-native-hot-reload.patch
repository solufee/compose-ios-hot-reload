-internal fun createIntermediateKlib(): Path =
-    Path(System.getProperty("java.io.tmpdir"), "${UUID.randomUUID()}.klib").also {
-        require(!it.exists()) { "Collision writing intermediate KLib $it" }
+internal fun createIntermediateKlib(arguments: K2NativeCompilerArguments): Path {
+    // Local hot-reload change: the intermediate klib used to be named with a random UUID.
+    // The per-file cache of the module being compiled is keyed by that name, so every run
+    // missed the cache and rebuilt the whole module. A stable name (target + output name +
+    // source set) lets the incremental cache be reused; content changes are still detected
+    // through the klib fingerprint recorded in the cache metadata.
+    val keySource = buildString {
+        append(arguments.target ?: "")
+        append('|')
+        append(arguments.outputName ?: "")
+        append('|')
+        append(arguments.freeArgs.sorted().joinToString("|"))
+    }
+    val key = java.security.MessageDigest.getInstance("SHA-1")
+            .digest(keySource.toByteArray())
+            .joinToString("") { "%02x".format(it) }
+            .take(16)
+    val dir = Path(System.getProperty("java.io.tmpdir"), "konan-hot-reload")
+    dir.toFile().mkdirs()
+    return dir.resolve("$key.klib").also {
         it.toFile().deleteOnExit()
     }
+}
