+        "libkotlin",
+        "libstdlib-cache"
+)
+
+/**
+ * Does this library need to be force-loaded into the host executable?
+ */
+private val String.isForceLoadCache: Boolean
+    get() = FORCE_LOADED_CACHES_FQN.any { this@isForceLoadCache.contains(it) }
