+}
+
+private fun CodeGenerator.buildWritableTypeInfoValue(
+        convertToRetained: ConstPointer?,
+        objCClass: ConstPointer?,
+        swiftClass: ConstPointer? = null,
+        typeAdapter: ConstPointer?
+): Struct = buildWritableTypeInfoValue(
+        writableTypeInfoType = runtime.writableTypeInfoType!!,
+        typeInfoObjCExportAddition = runtime.typeInfoObjCExportAddition,
+        convertToRetained = convertToRetained,
+        objCClass = objCClass,
+        swiftClass = swiftClass,
+        typeAdapter = typeAdapter,
+        llvmPointerType = llvm.pointerType
+)
+
+/**
+ * Split compilation (hot reload): an external class's WritableTypeInfo is defined in the host image, while this code
+ * goes into the JIT-loaded bootstrap, so the link-time replacement used for ordinary binaries cannot happen. Without it,
+ * Kotlin boxes, strings and functions passed to Objective-C as `id` convert to generic Kotlin wrappers instead of
+ * NSNumber / NSString / blocks; for example `bundle.objectForInfoDictionaryKey(key) as? NSNumber` is null for a plist
+ * boolean (Compose's strict Info.plist check then fails at startup).
+ *
+ * Store the non-null fields from the program module's static initializer instead (it runs from Konan_constructors
+ * before any Kotlin code). Null fields are left alone, so type adapters bound earlier by the loader are kept.
+ * Only reached with the split compilation scheme; other binaries are unchanged.
+ */
+private fun CodeGenerator.storeWritableTypeInfoFieldsAtStartup(
+        irClass: IrClass,
+        convertToRetained: ConstPointer?,
+        typeAdapter: ConstPointer?,
+) {
+    if (convertToRetained == null && typeAdapter == null) return
+    val writableTypeInfoType = runtime.writableTypeInfoType ?: return
+    val additionType = runtime.typeInfoObjCExportAddition
+    val global = importGlobal(irClass.writableTypeInfoSymbolName, writableTypeInfoType, irClass)
+    val proto = LlvmFunctionSignature(LlvmRetType(llvm.voidType, isObjectType = false)).toProto(
+            name = "",
+            origin = null,
+            LLVMLinkage.LLVMPrivateLinkage
+    )
+    val initializer = generateFunctionNoRuntime(this, proto) {
+        val addition = structGep(writableTypeInfoType, global, 0)
+        // TypeInfoObjCExportAddition: convertToRetained, objCClass, swiftClass, typeAdapter.
+        convertToRetained?.let { store(it.llvm, structGep(additionType, addition, 0)) }
+        typeAdapter?.let { store(it.llvm, structGep(additionType, addition, 3)) }
+        ret(null)
+    }
+    llvm.otherStaticInitializers += initializer
+}
