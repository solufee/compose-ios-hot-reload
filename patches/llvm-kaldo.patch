+namespace {
+/// Only the user module's functions can be replaced by a reload. Keep the set
+/// small: externalizing every Compose symbol (100k+) bloats the ORC dependence
+/// graph and occasionally crashes simplifyDepGroups.
+llvm::StringSet<> loadHotSymbols() {
+  llvm::StringSet<> Result;
+  const char *Path = ::getenv("KALDO_HOT_SYMBOLS");
+  llvm::dbgs() << "[kaldo] :: KALDO_HOT_SYMBOLS=" << (Path ? Path : "<unset>")
+               << "\n";
+  if (!Path)
+    return Result;
+  std::ifstream In(Path);
+  std::string Line;
+  while (std::getline(In, Line)) {
+    if (!Line.empty() && Line.back() == '\r')
+      Line.pop_back();
+    if (!Line.empty())
+      Result.insert(Line);
+  }
+  llvm::dbgs() << "[kaldo] :: hot symbol set size=" << Result.size() << "\n";
+  return Result;
+}
+} // namespace
+
+bool llvm::kaldo::orc::plugin::isHotSymbol(llvm::StringRef Name) {
+  static const llvm::StringSet<> Hot = loadHotSymbols();
+  return Hot.empty() || Hot.contains(Name);
+}
