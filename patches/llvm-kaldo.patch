@@ -0,0 +1,72 @@
+#include "ModuleInitRunner.hpp"
+
+#include "llvm/ADT/DenseMap.h"
+#include "llvm/ExecutionEngine/Orc/Shared/ExecutorAddress.h"
+#include "llvm/Support/Endian.h"
+#include "llvm/Support/raw_ostream.h"
+
+#include <mutex>
+#include <vector>
+
+namespace {
+std::mutex InitsMutex;
+std::vector<void (*)()> PendingInits;
+} // namespace
+
+namespace llvm::kaldo::orc::plugin {
+
+void ModuleInitRunnerPlugin::modifyPassConfig(
+    llvm::orc::MaterializationResponsibility &MR, llvm::jitlink::LinkGraph &G,
+    llvm::jitlink::PassConfiguration &Config) {
+  Config.PostFixupPasses.emplace_back(
+      [&MR](llvm::jitlink::LinkGraph &Graph) -> llvm::Error {
+        std::lock_guard<std::mutex> Lock(InitsMutex);
+
+        // Map init-function address -> symbol name. The payload also carries
+        // the Kotlin runtime's own entries (`__Konan_constructors`,
+        // `injectToRuntime`); those must not run twice.
+        llvm::DenseMap<llvm::orc::ExecutorAddr, llvm::StringRef> Names;
+        for (auto *Sym : Graph.defined_symbols()) {
+          if (!Sym->hasName())
+            continue;
+          Names[Sym->getAddress()] = *Sym->getName();
+        }
+
+        for (auto &Section : Graph.sections()) {
+          if (!Section.getName().ends_with("__mod_init_func"))
+            continue;
+          for (auto *Block : Section.blocks()) {
+            auto Content = Block->getContent();
+            for (size_t I = 0; I + 8 <= Content.size(); I += 8) {
+              uint64_t Ptr = llvm::support::endian::read64le(
+                  reinterpret_cast<const uint8_t *>(Content.data()) + I);
+              if (Ptr == 0)
+                continue;
+              auto It = Names.find(llvm::orc::ExecutorAddr(Ptr));
+              if (It == Names.end() ||
+                  !It->second.starts_with("__GLOBAL__sub_I_"))
+                continue;
+              PendingInits.push_back(reinterpret_cast<void (*)()>(Ptr));
+            }
+          }
+        }
+        return llvm::Error::success();
+      });
+}
+
+} // namespace llvm::kaldo::orc::plugin
+
+/// Called from Kaldo once the bootstrap has been materialized; at that point
+/// every initializer address is final and all payloads are mapped.
+extern "C" void kaldo_run_module_inits() {
+  std::vector<void (*)()> Inits;
+  {
+    std::lock_guard<std::mutex> Lock(InitsMutex);
+    Inits.swap(PendingInits);
+  }
+  for (auto *Init : Inits)
+    Init();
+  if (!Inits.empty())
+    llvm::dbgs() << "[kaldo] :: ran " << Inits.size()
+                 << " C++ module initializers\n";
+}
