+        SelectorSlots.push_back({Block->getAddress().getValue(), RawString,
+                                 (uint64_t)RegisteredSel,
+                                 SelrefsSection->getName().str()});
+      }
       auto MutableContent = Block->getMutableContent(Graph);
+      if (MutableContent.data() == nullptr)
+        continue;
       memcpy(MutableContent.data(), &RegisteredSel, sizeof(void *));
 
       FixedCount++;
     }
 
+    // Selector constants embedded outside __objc_selrefs. C++/ObjC++ call
+    // sites may hold a raw __objc_methname pointer in a data slot that dyld
+    // never fixes up in a JIT'd payload.
+    {
+      std::vector<Range> Ranges;
+      {
+        std::lock_guard<std::mutex> Lock(SelectorSlotsMutex);
+        Ranges = MethnameRanges;
+      }
+      std::sort(Ranges.begin(), Ranges.end());
+      auto InMethname = [&](uint64_t V) {
+        auto It = std::upper_bound(
+            Ranges.begin(), Ranges.end(), V,
+            [](uint64_t Val, const Range &R) { return Val < R.first; });
+        if (It == Ranges.begin())
+          return false;
+        --It;
+        return V >= It->first && V < It->second;
+      };
+
+      int Embedded = 0;
+      for (auto &Sec : Graph.sections()) {
+        auto SecName = Sec.getName();
+        if (!SecName.starts_with("__DATA"))
+          continue;
+        for (auto *B : Sec.blocks()) {
+          auto Content = B->getContent();
+          if (Content.data() == nullptr || Content.size() < sizeof(uint64_t))
+            continue;
+          auto Mutable = B->getMutableContent(Graph);
+          if (Mutable.data() == nullptr)
+            continue;
+          for (size_t I = 0; I + sizeof(uint64_t) <= Content.size();
+               I += sizeof(uint64_t)) {
+            uint64_t Raw;
+            memcpy(&Raw, Content.data() + I, sizeof(Raw));
+            if (Raw == 0 || !InMethname(Raw))
+              continue;
+            const char *Str = reinterpret_cast<const char *>(Raw);
+            size_t Len = strnlen(Str, 128);
+            if (Len == 0 || Len >= 128)
+              continue;
+            bool Printable = true;
+            for (size_t J = 0; J < Len; ++J) {
+              unsigned char C = (unsigned char)Str[J];
+              if (!(isalnum(C) || C == '_' || C == ':')) {
+                Printable = false;
+                break;
+              }
+            }
+            if (!Printable)
+              continue;
+            SEL Registered = sel_registerName(Str);
+            memcpy(Mutable.data() + I, &Registered, sizeof(Registered));
+            {
+              std::lock_guard<std::mutex> Lock(SelectorSlotsMutex);
+              EmbeddedSelectorSlots.push_back(
+                  {B->getAddress().getValue() + I, Raw,
+                   (uint64_t)Registered, SecName.str()});
+            }
+            ++Embedded;
+          }
+        }
+      }
+      if (Embedded)
+        dbgs() << "[kaldo] :: registered " << Embedded
+               << " embedded selector constants\n";
+    }
+
     dbgs() << "[kaldo] :: ObjCSelectorFixupPlugin fixed " << FixedCount
            << " selector references\n";
 
     return llvm::Error::success();
   });
 }
+
+void llvm::kaldo::orc::plugin::registerPendingObjCSelectorRefs() {
+  std::lock_guard<std::mutex> Lock(SelectorSlotsMutex);
+  int Fixed = 0;
+  for (const auto &Slot : SelectorSlots) {
+    if (!Slot.Address)
+      continue;
+    auto *Value = reinterpret_cast<uint64_t *>(Slot.Address);
+    if (*Value != Slot.RawString)
+      continue;
+    *Value = Slot.RegisteredSel;
+    ++Fixed;
+  }
+
+  // Slots that no JITLink block covers (gaps inside the __objc_selrefs range)
+  // are still selector references; register them from the section range.
+  for (const auto &[Lo, Hi] : SelectorSectionRanges) {
+    for (uint64_t Addr = Lo; Addr + sizeof(uint64_t) <= Hi; Addr += sizeof(uint64_t)) {
+      auto *Value = reinterpret_cast<uint64_t *>(Addr);
+      uint64_t Current = *Value;
+      if (Current == 0)
+        continue;
+      const char *Str = reinterpret_cast<const char *>(Current);
+      size_t Len = strnlen(Str, 128);
+      if (Len == 0 || Len >= 128)
+        continue;
+      bool Printable = true;
+      for (size_t I = 0; I < Len; ++I) {
+        unsigned char C = (unsigned char)Str[I];
+        if (!(isalnum(C) || C == '_' || C == ':')) {
+          Printable = false;
+          break;
+        }
+      }
+      if (!Printable)
+        continue;
+      SEL Registered = sel_registerName(Str);
+      // Debug trace of the gap selectors; off unless KALDO_DEBUG_SELREFS=1.
+      static const bool DebugSelrefs = [] {
+        const char *V = ::getenv("KALDO_DEBUG_SELREFS");
+        return V != nullptr && V[0] == '1' && V[1] == '\0';
+      }();
+      if (DebugSelrefs) {
+        if (FILE *F = fopen("/tmp/gap-selrefs.log", "a")) {
+          fprintf(F, "%#llx %s\n", (unsigned long long)Addr, Str);
+          fclose(F);
+        }
+      }
+      *Value = (uint64_t)Registered;
+      ++Fixed;
+    }
+  }
+
+  // Embedded selector constants recorded at PostFixup: the runtime's global
+  // re-initialization can overwrite them with the original string pointers.
+  for (const auto &Slot : EmbeddedSelectorSlots) {
+    if (!Slot.Address)
+      continue;
+    auto *Value = reinterpret_cast<uint64_t *>(Slot.Address);
+    if (*Value != Slot.RawString)
+      continue;
+    *Value = Slot.RegisteredSel;
+    ++Fixed;
+  }
+
+  // Full check: every recorded slot must hold a registered selector now.
+  size_t Total = 0;
+  size_t Unmapped = 0;
+  for (const auto *List : {&SelectorSlots, &EmbeddedSelectorSlots}) {
+    for (const auto &Slot : *List) {
+      ++Total;
+      auto *Value = reinterpret_cast<uint64_t *>(Slot.Address);
+      if (*Value == Slot.RawString) {
+        ++Unmapped;
+        if (Unmapped <= 10) {
+          const char *Str = reinterpret_cast<const char *>(Slot.RawString);
+          llvm::dbgs() << "[kaldo] :: SELREF unmapped slot=0x"
+                       << llvm::Twine::utohexstr(Slot.Address) << " section="
+                       << Slot.Section << " string=" << Str << "\n";
+        }
+      }
+    }
+  }
+  llvm::dbgs() << "[kaldo] :: SELREF check: " << Total << " slots, " << Unmapped
+               << " unmapped\n";
+
+  llvm::dbgs() << "[kaldo] :: re-registered " << Fixed
+               << " selector references after runtime init\n";
+}
