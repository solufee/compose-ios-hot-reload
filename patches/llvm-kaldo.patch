+++ b/llvm/tools/kaldo/plugins/CompactUnwindEhFrame.cpp
@@ -0,0 +1,572 @@
+#include "CompactUnwindEhFrame.hpp"
+
+#include "llvm/ADT/DenseMap.h"
+#include "llvm/Support/Endian.h"
+#include "llvm/Support/raw_ostream.h"
+
+#include <chrono>
+#include <cstdint>
+#include <cstdlib>
+#include <memory>
+#include <mutex>
+#include <string>
+#include <vector>
+
+using namespace llvm;
+using namespace llvm::jitlink;
+
+extern "C" void __register_frame(const void *);
+// Whole-section registration: libunwind parses the section lazily and adds all
+// FDEs in one call. Weak so older runtimes keep the per-FDE fallback.
+extern "C" void __unw_add_dynamic_eh_frame_section(uintptr_t)
+    __attribute__((weak_import));
+// libc++abi's personality; referenced so the pointer is real even though the
+// symbol lives outside the JIT graph.
+extern "C" void __gxx_personality_v0();
+
+namespace {
+
+// Apple compact-unwind (arm64) encoding.
+constexpr uint32_t UNWIND_ARM64_MODE_MASK = 0x0F000000;
+constexpr uint32_t UNWIND_ARM64_MODE_FRAMELESS = 0x02000000;
+constexpr uint32_t UNWIND_ARM64_MODE_DWARF = 0x03000000;
+constexpr uint32_t UNWIND_ARM64_MODE_FRAME = 0x04000000;
+constexpr uint32_t UNWIND_ARM64_FRAMELESS_STACK_SIZE_MASK = 0x00FFF000;
+
+constexpr uint8_t DW_CFA_def_cfa = 0x0C;
+constexpr uint8_t DW_CFA_offset = 0x80;
+
+constexpr uint8_t DW_EH_PE_absptr = 0x00;
+constexpr uint8_t DW_EH_PE_pcrel_sdata4 = 0x1B;
+
+bool profiling() {
+  static const bool On = ::getenv("KALDO_EH_PROFILE") != nullptr;
+  return On;
+}
+
+void appendULEB(std::vector<uint8_t> &Out, uint64_t V) {
+  do {
+    uint8_t B = V & 0x7F;
+    V >>= 7;
+    if (V)
+      B |= 0x80;
+    Out.push_back(B);
+  } while (V);
+}
+
+void appendSLEB(std::vector<uint8_t> &Out, int64_t V) {
+  bool More = true;
+  while (More) {
+    uint8_t B = V & 0x7F;
+    V >>= 7;
+    if ((V == 0 && (B & 0x40) == 0) || (V == -1 && (B & 0x40) != 0))
+      More = false;
+    else
+      B |= 0x80;
+    Out.push_back(B);
+  }
+}
+
+void append32(std::vector<uint8_t> &Out, uint32_t V) {
+  size_t At = Out.size();
+  Out.resize(At + 4);
+  support::endian::write32le(Out.data() + At, V);
+}
+
+void dumpBytes(const char *Tag, const uint8_t *Data, size_t N) {
+  llvm::dbgs() << "[kaldo] :: " << Tag << " (" << N << "):";
+  for (size_t I = 0; I < N; ++I)
+    llvm::dbgs() << " " << llvm::format_hex_no_prefix(Data[I], 2);
+  llvm::dbgs() << "\n";
+}
+
+/// Build a CIE. Personality uses absptr (libc++abi is >2GB from the JIT);
+/// FDE pointers and LSDA use pcrel|sdata4. `PersonalityOffset` is the byte
+/// offset of the 8-byte personality slot inside the returned buffer.
+std::vector<uint8_t> buildCIE(bool HasPersonality, bool HasLSDA,
+                              size_t &PersonalityOffset) {
+  PersonalityOffset = 0;
+  std::vector<uint8_t> CIE;
+  append32(CIE, 0); // length, fixed at the end
+  append32(CIE, 0); // CIE id
+  CIE.push_back(1); // version
+  // A CIE that declares 'L' forces every FDE to carry an LSDA field, so only
+  // use "zPLR" when the FDE really has one.
+  const char *Aug = HasPersonality ? (HasLSDA ? "zPLR" : "zPR") : "zR";
+  for (const char *C = Aug; *C; ++C)
+    CIE.push_back(static_cast<uint8_t>(*C));
+  CIE.push_back(0);
+  appendULEB(CIE, 1);  // code alignment
+  appendSLEB(CIE, -8); // data alignment
+  appendULEB(CIE, 30); // return address register (x30)
+
+  size_t AugLenAt = CIE.size();
+  appendULEB(CIE, 0); // augmentation length, fixed below
+  if (HasPersonality) {
+    CIE.push_back(DW_EH_PE_absptr); // 'P'
+    PersonalityOffset = CIE.size();
+    CIE.resize(CIE.size() + 8, 0);
+    if (HasLSDA)
+      CIE.push_back(DW_EH_PE_pcrel_sdata4); // 'L'
+  }
+  CIE.push_back(DW_EH_PE_pcrel_sdata4); // 'R'
+
+  CIE[AugLenAt] = static_cast<uint8_t>(CIE.size() - AugLenAt - 1);
+  support::endian::write32le(CIE.data(),
+                             static_cast<uint32_t>(CIE.size() - 4));
+  return CIE;
+}
+
+/// CFI instructions for one function, from its compact-unwind encoding.
+bool buildCFI(uint32_t Encoding, std::vector<uint8_t> &Out) {
+  uint32_t Mode = Encoding & UNWIND_ARM64_MODE_MASK;
+  if (Mode == UNWIND_ARM64_MODE_FRAMELESS) {
+    uint64_t Stack =
+        ((Encoding & UNWIND_ARM64_FRAMELESS_STACK_SIZE_MASK) >> 12) * 16;
+    Out.push_back(DW_CFA_def_cfa);
+    appendULEB(Out, 31); // sp
+    appendULEB(Out, Stack);
+    return true;
+  }
+  if (Mode != UNWIND_ARM64_MODE_FRAME)
+    return false;
+
+  Out.push_back(DW_CFA_def_cfa);
+  appendULEB(Out, 29); // fp
+  appendULEB(Out, 16);
+  Out.push_back(DW_CFA_offset | 29); // fp at CFA-16
+  appendULEB(Out, 2);
+  Out.push_back(DW_CFA_offset | 30); // lr at CFA-8
+  appendULEB(Out, 1);
+
+  struct Pair {
+    uint32_t Bit;
+    uint8_t First;
+    uint8_t Second;
+  };
+  static const Pair Pairs[] = {
+      {0x00000001, 19, 20}, {0x00000002, 21, 22}, {0x00000004, 23, 24},
+      {0x00000008, 25, 26}, {0x00000010, 27, 28}, {0x00000100, 72, 73},
+      {0x00000200, 74, 75}, {0x00000400, 76, 77}, {0x00000800, 78, 79},
+  };
+  uint64_t Offset = 24;
+  for (const auto &P : Pairs) {
+    if ((Encoding & P.Bit) == 0)
+      continue;
+    Out.push_back(DW_CFA_offset | (P.First & 0x3F));
+    appendULEB(Out, Offset / 8);
+    Offset += 8;
+    Out.push_back(DW_CFA_offset | (P.Second & 0x3F));
+    appendULEB(Out, Offset / 8);
+    Offset += 8;
+  }
+  return true;
+}
+
+/// One synthesized block: [CIE][FDE]. Keeping the CIE inside the block makes
+/// cie_pointer a constant, independent of how JITLink orders blocks. All
+/// records now live back-to-back in one section-sized block, so both
+/// synthesis and registration are single-pass.
+struct FDERecord {
+  size_t Off = 0; // start of the [CIE] within the section
+  size_t CieLen = 0;
+  size_t FdeOff = 0; // CIE length; FDE starts at Off + FdeOff
+  size_t RecSize = 0;
+  size_t PersonalityOff = 0; // relative to Off
+  size_t LSDAOff = 0;        // relative to Off
+  uint32_t Range = 0;
+  StringRef FunctionName;
+  Symbol *FunctionSym = nullptr;
+  Symbol *LSDASym = nullptr;
+  int64_t LSDAOffsetInSection = -1;
+};
+
+struct State {
+  std::mutex M;
+  Block *SectionBlock = nullptr;
+  std::vector<FDERecord> FDEs;
+};
+
+} // namespace
+
+void llvm::kaldo::orc::plugin::CompactUnwindToEHFramePlugin::modifyPassConfig(
+    llvm::orc::MaterializationResponsibility &MR, LinkGraph &G,
+    PassConfiguration &Config) {
+  // Enabled by any non-empty value other than "0"; unset, "" and "0" mean off.
+  const char *Synth = ::getenv("KALDO_SYNTH_EH_FRAME");
+  if (Synth == nullptr || Synth[0] == '\0' || (Synth[0] == '0' && Synth[1] == '\0'))
+    return;
+
+  auto S = std::make_shared<State>();
+
+  Config.PrePrunePasses.insert(
+      Config.PrePrunePasses.begin(), [S](LinkGraph &Graph) -> Error {
+        auto T0 = std::chrono::steady_clock::now();
+        auto *CUSec = Graph.findSectionByName("__KALDO,__kaldo_cu");
+        if (!CUSec)
+          CUSec = Graph.findSectionByName("__KALDO,__compact_unwind");
+        if (!CUSec)
+          CUSec = Graph.findSectionByName("__LD,__compact_unwind");
+        if (!CUSec || CUSec->empty())
+          return Error::success();
+
+        Section *EH = Graph.findSectionByName("__TEXT,__kaldo_eh_frame");
+        if (!EH)
+          EH = &Graph.createSection(
+              "__TEXT,__kaldo_eh_frame",
+              static_cast<llvm::orc::MemProt>(
+                  static_cast<unsigned>(llvm::orc::MemProt::Read)));
+
+        uint64_t GccStart = ~0ull;
+        if (auto *Gcc = Graph.findSectionByName("__TEXT,__gcc_except_tab")) {
+          unsigned Keep = 0;
+          for (auto *B : Gcc->blocks()) {
+            GccStart = std::min(GccStart, B->getAddress().getValue());
+            auto &KeepSym = Graph.addDefinedSymbol(
+                *B, 0, Graph.intern("__kaldo_lsda_" + llvm::Twine(Keep).str()),
+                1, Linkage::Strong, Scope::Local, false, false);
+            KeepSym.setLive(true);
+            ++Keep;
+          }
+        }
+
+        struct RawRecord {
+          Block *Block;
+          size_t Offset;
+          uint32_t Range;
+          uint32_t Encoding;
+          StringRef Function;
+          bool HasPersonality;
+          bool HasLSDA;
+          Symbol *FunctionSymbol;
+          Symbol *LSDASymbol;
+          int64_t LSDAOffsetInSection;
+        };
+
+        struct EdgeTargets {
+          Symbol *FirstNamed = nullptr;
+          Symbol *FirstDefinedNamed = nullptr;
+          Symbol *FirstDefined = nullptr;
+        };
+
+        std::vector<RawRecord> Records;
+        Records.reserve(131072);
+        unsigned SkippedDwarf = 0, SkippedOther = 0;
+
+        constexpr size_t RecordSize = 32;
+        for (auto *B : CUSec->blocks()) {
+          // edges_at() scans every edge in the block, and a merged payload has
+          // hundreds of thousands of edges: calling it per record is O(N^2)
+          // (~20s for 126k records). Index one pass per block instead.
+          DenseMap<uint64_t, EdgeTargets> EdgeIndex;
+          EdgeIndex.reserve(B->edges_size());
+          for (auto &E : B->edges()) {
+            auto &T = E.getTarget();
+            auto &Slot = EdgeIndex[E.getOffset()];
+            if (!Slot.FirstNamed && T.hasName())
+              Slot.FirstNamed = &T;
+            if (!Slot.FirstDefinedNamed && T.hasName() && T.isDefined())
+              Slot.FirstDefinedNamed = &T;
+            if (!Slot.FirstDefined && T.isDefined())
+              Slot.FirstDefined = &T;
+          }
+          auto NamedAt = [&](size_t Off, bool MustBeDefined) -> StringRef {
+            auto It = EdgeIndex.find(Off);
+            if (It == EdgeIndex.end())
+              return {};
+            Symbol *S =
+                MustBeDefined ? It->second.FirstDefinedNamed
+                              : It->second.FirstNamed;
+            if (!S || !S->hasName())
+              return {};
+            return *S->getName();
+          };
+
+          auto Content = B->getContent();
+          for (size_t Rec = 0; Rec + RecordSize <= Content.size();
+               Rec += RecordSize) {
+            const uint8_t *RecData =
+                reinterpret_cast<const uint8_t *>(Content.data()) + Rec;
+            uint32_t Range = support::endian::read32le(RecData + 8);
+            uint32_t Encoding = support::endian::read32le(RecData + 12);
+
+            uint32_t Mode = Encoding & UNWIND_ARM64_MODE_MASK;
+            if (Mode == UNWIND_ARM64_MODE_DWARF) {
+              ++SkippedDwarf;
+              continue;
+            }
+            if (Mode != UNWIND_ARM64_MODE_FRAME &&
+                Mode != UNWIND_ARM64_MODE_FRAMELESS) {
+              ++SkippedOther;
+              continue;
+            }
+
+            StringRef Fn = NamedAt(Rec, true);
+            if (Fn.empty()) {
+              ++SkippedOther;
+              continue;
+            }
+            Symbol *FnSym = EdgeIndex[Rec].FirstDefinedNamed;
+            StringRef Personality = NamedAt(Rec + 16, false);
+            StringRef LSDA = NamedAt(Rec + 24, false);
+            Symbol *LSDASym = EdgeIndex[Rec + 24].FirstDefined;
+            int64_t LSDAOffInSec = -1;
+            if (LSDASym && GccStart != ~0ull) {
+              uint64_t A = LSDASym->getAddress().getValue();
+              if (A >= GccStart)
+                LSDAOffInSec = static_cast<int64_t>(A - GccStart);
+            }
+            Records.push_back({B, Rec, Range, Encoding, Fn, !Personality.empty(),
+                               !LSDA.empty(), FnSym, LSDASym, LSDAOffInSec});
+          }
+        }
+        auto TScan = std::chrono::steady_clock::now();
+
+        // Three CIE variants, built once instead of per record.
+        std::vector<uint8_t> CIEs[2][2];
+        size_t CiePersonalityOff[2][2] = {{0, 0}, {0, 0}};
+        for (int P = 0; P < 2; ++P)
+          for (int L = 0; L < 2; ++L) {
+            if (L && !P)
+              continue;
+            CIEs[P][L] = buildCIE(P, L, CiePersonalityOff[P][L]);
+          }
+
+        // Upper bound: CIE (<= 45) + FDE + CFI (<= 40) per record, plus the
+        // zero terminator libunwind expects at the end of the section.
+        std::vector<uint8_t> Section;
+        Section.reserve(Records.size() * 96 + 4);
+        S->FDEs.reserve(Records.size());
+
+        unsigned Emitted = 0, WithLSDA = 0, PersonalityNoLSDA = 0;
+        for (auto &R : Records) {
+          std::vector<uint8_t> CFI;
+          if (!buildCFI(R.Encoding, CFI))
+            continue;
+
+          bool HasPersonality = R.HasPersonality;
+          bool HasLSDA = HasPersonality && R.HasLSDA;
+          if (HasLSDA)
+            ++WithLSDA;
+          else if (HasPersonality)
+            ++PersonalityNoLSDA;
+
+          const auto &CIE = CIEs[HasPersonality][HasLSDA];
+          size_t Off = Section.size();
+          Section.insert(Section.end(), CIE.begin(), CIE.end());
+          size_t CieLen = CIE.size();
+          size_t FdeOff = CieLen;
+
+          size_t FdeLen = 4 + 4 + 4 + (HasLSDA ? 5 : 1) + CFI.size();
+          append32(Section, static_cast<uint32_t>(FdeLen));
+          append32(Section, static_cast<uint32_t>(FdeOff + 4)); // cie_pointer
+          append32(Section, 0); // pc_begin, patched in PostFixup
+          append32(Section, R.Range);
+          size_t LSDAOff = 0;
+          if (HasLSDA) {
+            appendULEB(Section, 4);
+            LSDAOff = Section.size() - Off;
+            append32(Section, 0);
+          } else {
+            appendULEB(Section, 0);
+          }
+          Section.insert(Section.end(), CFI.begin(), CFI.end());
+
+          S->FDEs.push_back({Off, CieLen, FdeOff, Section.size() - Off,
+                             CiePersonalityOff[HasPersonality][HasLSDA],
+                             LSDAOff, R.Range, R.Function, R.FunctionSymbol,
+                             R.LSDASymbol, R.LSDAOffsetInSection});
+          ++Emitted;
+        }
+        append32(Section, 0); // section terminator for libunwind
+
+        auto Buf = Graph.allocateBuffer(Section.size());
+        memcpy(Buf.data(), Section.data(), Section.size());
+        auto &Block = Graph.createContentBlock(
+            *EH, Buf, llvm::orc::ExecutorAddr(), 8, 0);
+        auto &Sym = Graph.addDefinedSymbol(
+            Block, 0, Graph.intern("__kaldo_eh_frame"), 1, Linkage::Strong,
+            Scope::Local, false, false);
+        Sym.setLive(true);
+        S->SectionBlock = &Block;
+
+        if (::getenv("KALDO_EH_DUMP") && Emitted > 0)
+          dumpBytes("section-head",
+                    reinterpret_cast<const uint8_t *>(Buf.data()),
+                    std::min<size_t>(64, Buf.size()));
+
+        auto TEnd = std::chrono::steady_clock::now();
+        dbgs() << "[kaldo] :: synthesized " << Emitted << " inline-CIE FDEs"
+               << ", skipped DWARF=" << SkippedDwarf
+               << " other=" << SkippedOther << ", withLSDA=" << WithLSDA
+               << ", personalityNoLSDA=" << PersonalityNoLSDA
+               << ", section=" << Section.size() << " bytes\n";
+        if (profiling())
+          dbgs() << "[kaldo] :: profile: scan="
+                 << std::chrono::duration_cast<std::chrono::milliseconds>(
+                        TScan - T0).count()
+                 << "ms emit="
+                 << std::chrono::duration_cast<std::chrono::milliseconds>(
+                        TEnd - TScan).count()
+                 << "ms\n";
+        return Error::success();
+      });
+
+  Config.PostFixupPasses.emplace_back([S](LinkGraph &Graph) -> Error {
+    std::lock_guard<std::mutex> Lock(S->M);
+    auto T0 = std::chrono::steady_clock::now();
+
+    uint64_t GccBase = ~0ull, GccEnd = 0;
+    if (auto *Gcc = Graph.findSectionByName("__TEXT,__gcc_except_tab"))
+      for (auto *B : Gcc->blocks()) {
+        GccBase = std::min(GccBase, B->getAddress().getValue());
+        GccEnd = std::max(GccEnd, B->getAddress().getValue() + B->getSize());
+      }
+    if (GccBase == ~0ull)
+      GccBase = 0;
+
+    uint64_t TextBase = ~0ull, TextEnd = 0;
+    for (auto &Sec : Graph.sections())
+      if (Sec.getName() == "__TEXT,__text")
+        for (auto *B : Sec.blocks()) {
+          TextBase = std::min(TextBase, B->getAddress().getValue());
+          TextEnd = std::max(TextEnd, B->getAddress().getValue() + B->getSize());
+        }
+
+    unsigned Patched = 0, Registered = 0;
+    unsigned LsdaCount = 0, LsdaOutOfRange = 0, PcOutOfRange = 0;
+    unsigned UnresolvedPersonality = 0;
+
+    auto *Block = S->SectionBlock;
+    if (!Block)
+      return Error::success();
+    auto Mutable = Block->getMutableContent(Graph);
+    if (Mutable.data() == nullptr)
+      return Error::success();
+    auto *Base = reinterpret_cast<uint8_t *>(Mutable.data());
+    uint64_t BlockAddr = Block->getAddress().getValue();
+
+    uint64_t Personality = 0;
+    if (auto *Sym = Graph.findDefinedSymbolByName(
+            Graph.intern("___gxx_personality_v0")))
+      Personality = Sym->getAddress().getValue();
+    if (Personality == 0)
+      Personality = reinterpret_cast<uint64_t>(&__gxx_personality_v0);
+
+    for (auto &FDE : S->FDEs) {
+      if (Mutable.size() < FDE.Off + FDE.RecSize)
+        continue;
+      auto *RecBase = Base + FDE.Off;
+      auto *Data = RecBase + FDE.FdeOff;
+
+      auto *Fn = FDE.FunctionSym;
+      if (!Fn || !Fn->isDefined())
+        continue;
+
+      uint64_t FdeAddr = BlockAddr + FDE.Off + FDE.FdeOff;
+
+      uint64_t FnAddr = Fn->getAddress().getValue();
+      if (FnAddr != 0 &&
+          FDE.FunctionName.starts_with("_kfun:") &&
+          TextBase != ~0ull && (FnAddr < TextBase || FnAddr >= TextEnd)) {
+        ++PcOutOfRange;
+        if (PcOutOfRange <= 5)
+          dbgs() << "[kaldo] :: EH check: pc out of range 0x"
+                 << llvm::Twine::utohexstr(FnAddr) << " for " << FDE.FunctionName
+                 << "\n";
+      }
+      int64_t PcDelta =
+          static_cast<int64_t>(FnAddr) - static_cast<int64_t>(FdeAddr + 8);
+      support::endian::write32le(Data + 8, static_cast<uint32_t>(PcDelta));
+      support::endian::write32le(Data + 12, static_cast<uint32_t>(FDE.Range));
+
+      if (FDE.LSDAOff != 0) {
+        uint64_t LsdaAddr = 0;
+        if (FDE.LSDASym && FDE.LSDASym->isDefined())
+          LsdaAddr = FDE.LSDASym->getAddress().getValue();
+        if (LsdaAddr == 0 && FDE.LSDAOffsetInSection >= 0 && GccBase != 0)
+          LsdaAddr = GccBase + static_cast<uint64_t>(FDE.LSDAOffsetInSection);
+
+        ++LsdaCount;
+        if (LsdaAddr == 0 || LsdaAddr < GccBase || LsdaAddr >= GccEnd) {
+          ++LsdaOutOfRange;
+          if (LsdaOutOfRange <= 5)
+            dbgs() << "[kaldo] :: EH check: LSDA out of range 0x"
+                   << llvm::Twine::utohexstr(LsdaAddr) << " for "
+                   << FDE.FunctionName << "\n";
+        } else {
+          // LSDAOff is relative to the record (the CIE precedes the FDE), so
+          // the field address is RecBase + LSDAOff.
+          uint64_t LsdaField = BlockAddr + FDE.Off + FDE.LSDAOff;
+          int64_t LsdaDelta = static_cast<int64_t>(LsdaAddr) -
+                              static_cast<int64_t>(LsdaField);
+          support::endian::write32le(RecBase + FDE.LSDAOff,
+                                     static_cast<uint32_t>(LsdaDelta));
+
+          // Decode back the way libunwind does.
+          int32_t Enc = static_cast<int32_t>(LsdaDelta);
+          uint64_t Decoded = LsdaField + static_cast<int64_t>(Enc);
+          bool Bad = Decoded != LsdaAddr;
+          if (!Bad) {
+            const uint8_t *P = reinterpret_cast<const uint8_t *>(Decoded);
+            if (P[0] != 0xFF)
+              Bad = true;
+          }
+          if (Bad) {
+            ++LsdaOutOfRange;
+            if (LsdaOutOfRange <= 5)
+              dbgs() << "[kaldo] :: EH check: LSDA decode mismatch 0x"
+                     << llvm::Twine::utohexstr(Decoded) << " expected 0x"
+                     << llvm::Twine::utohexstr(LsdaAddr) << " for "
+                     << FDE.FunctionName << "\n";
+          }
+        }
+      }
+
+      if (FDE.PersonalityOff != 0) {
+        if (Personality == 0) {
+          ++UnresolvedPersonality;
+        } else {
+          support::endian::write64le(RecBase + FDE.PersonalityOff, Personality);
+        }
+      }
+
+      ++Patched;
+    }
+
+    // One call registers the whole section; libunwind walks it lazily.
+    if (Patched > 0 && ::getenv("KALDO_EH_SKIP_REGISTER") == nullptr) {
+      if (__unw_add_dynamic_eh_frame_section) {
+        __unw_add_dynamic_eh_frame_section(
+            reinterpret_cast<uintptr_t>(Base));
+        Registered = Patched;
+      } else {
+        for (auto &FDE : S->FDEs) {
+          auto *Fn = FDE.FunctionSym;
+          if (!Fn || !Fn->isDefined())
+            continue;
+          __register_frame(reinterpret_cast<const void *>(
+              Base + FDE.Off + FDE.FdeOff));
+          ++Registered;
+        }
+      }
+    }
+
+    auto TEnd = std::chrono::steady_clock::now();
+    dbgs() << "[kaldo] :: EH check: " << S->FDEs.size() << " FDE, " << LsdaCount
+           << " lsda, " << LsdaOutOfRange << " lsda-out-of-range, "
+           << PcOutOfRange << " pc-out-of-range, " << UnresolvedPersonality
+           << " unresolved-personality\n";
+    dbgs() << "[kaldo] :: patched " << Patched << " FDEs, registered "
+           << Registered << " ("
+           << (__unw_add_dynamic_eh_frame_section ? "section" : "per-fde")
+           << ")\n";
+    if (profiling())
+      dbgs() << "[kaldo] :: profile: patch+register="
+             << std::chrono::duration_cast<std::chrono::milliseconds>(TEnd - T0)
+                    .count()
+             << "ms\n";
+    S->FDEs.clear();
+    return Error::success();
+  });
+}
